{
  // Type-checking only, for the Vite config. It runs in Node rather than the
  // browser, so it gets Node's types instead of tsconfig.json's DOM ones.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
