{
  // Type-checking only: Vite compiles the code, so nothing is emitted here.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    // `@/` -> src/, the import prefix shadcn/ui components are generated with.
    // Mirrors the alias in vite.config.ts.
    "paths": {
      "@/*": ["./src/*"]
    },

    // google.maps: @vis.gl/react-google-maps uses the global `google` namespace
    // without referencing it, so it has to be listed here to resolve.
    "types": [
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom/vitest",
      "google.maps"
    ]
  },
  "include": ["src"]
}
