{
  // Type-checking only: Node runs the .ts files directly by stripping their
  // types, so nothing is emitted and the options below keep the code within
  // what type stripping can handle.
  "compilerOptions": {
    "target": "esnext",
    // No DOM: browser globals do not exist here, and @types/node supplies the
    // real fetch types (its json() returns unknown, not the DOM's any).
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,

    // Node needs the real extension on relative imports (./app.ts).
    "allowImportingTsExtensions": true,
    // No enums, namespaces or parameter properties: Node cannot strip them.
    "erasableSyntaxOnly": true,
    // Type-only imports must say so, since stripping removes them wholesale.
    "verbatimModuleSyntax": true,

    "types": ["node"]
  },
  "include": ["**/*.js", "**/*.ts"]
}
