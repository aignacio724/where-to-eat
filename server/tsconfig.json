{
  // Node runs these .ts files directly by stripping the types, so tsc is only
  // a type checker here (noEmit). The options below keep the source to what
  // type stripping supports: explicit .ts import extensions, `import type` for
  // type-only imports, and no syntax that needs transpiling (enums, namespaces).
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
